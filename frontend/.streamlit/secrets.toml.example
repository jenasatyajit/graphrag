# Copy this file to `.streamlit/secrets.toml` and fill in the values.
# The real `secrets.toml` is git-ignored — never commit it.
#
# On Streamlit Community Cloud, set these in the app's Secrets dashboard
# (same TOML format) instead of committing a file.

# Base URL of the public GraphRAG query API.
# Local dev example:   "http://127.0.0.1:8000"
# Production example:   a public HTTPS URL, e.g. "https://your-api.example.com"
API_BASE_URL = "http://127.0.0.1:8000"

# Optional: override where the Reports view looks for committed eval reports.
# Defaults to the repo's backend/data/eval/reports/ directory.
# EVAL_REPORT_DIR = "/path/to/eval/reports"

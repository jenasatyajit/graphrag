# Copy this file to `.env` and fill in the required credentials below.
# Required keys: SARVAM_API_KEY, OPENROUTER_API_KEY, EXA_API_KEY, QDRANT_URL,
# QDRANT_API_KEY, NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD, and (for the query API)
# EMBEDDING_SERVICE_URL. Every other key is optional: leaving it blank uses the
# built-in default, so only set it when you want a non-default value.

# Sarvam API key for routing and answer synthesis.
SARVAM_API_KEY=
# OpenRouter API key for hosted reranking (cohere/rerank-4-fast).
OPENROUTER_API_KEY=
# Exa API key for live external web search.
EXA_API_KEY=
# Qdrant Cloud endpoint URL.
QDRANT_URL=
# Qdrant Cloud API key.
QDRANT_API_KEY=
# Neo4j AuraDB connection URI.
NEO4J_URI=
# Neo4j database username.
NEO4J_USER=
# Neo4j database password.
NEO4J_PASSWORD=
# Neo4j target database name (AuraDB default is "neo4j").
NEO4J_DATABASE=
# Neo4j query timeout in seconds.
GRAPH_QUERY_TIMEOUT_SECONDS=
# Bounded retry count for transient Neo4j failures.
GRAPH_MAX_RETRIES=
# Maximum hops for graph traversal at query time (1-3).
GRAPH_TRAVERSAL_MAX_HOPS=
# Maximum candidate entity nodes matched per question.
GRAPH_ENTITY_MATCH_LIMIT=
# Maximum graph facts fused into the synthesis context.
GRAPH_FACT_LIMIT=
# Embedding model identifier; e.g. BAAI/bge-m3.
EMBEDDING_MODEL=
# OpenRouter base URL for the /rerank endpoint.
OPENROUTER_BASE_URL=
# OpenRouter reranker model id; default cohere/rerank-4-fast (pro for eval).
RERANK_MODEL=
# Number of candidates returned after reranking.
RERANK_TOP_N=
# Fused candidates sent to the reranker before top-n truncation.
RERANK_CANDIDATE_LIMIT=
# OpenRouter rerank request timeout in seconds.
RERANK_REQUEST_TIMEOUT_SECONDS=
# Bounded retry count for transient OpenRouter rerank failures.
RERANK_MAX_RETRIES=
# Sarvam chat model identifier; e.g. sarvam-105b.
LLM_MODEL=
# Router reasoning effort; leave blank/null to disable it.
LLM_ROUTER_REASONING_EFFORT=
# Synthesis reasoning effort; e.g. low.
LLM_SYNTH_REASONING_EFFORT=
# Graph/entity extraction reasoning effort; default "medium" (low/None give
# empty replies on content-rich chunks). Set null only if you accept a sparse graph.
LLM_EXTRACT_REASONING_EFFORT=
# Max completion tokens for extraction calls; default 4096 (room for reasoning).
LLM_EXTRACT_MAX_TOKENS=
# Maximum total router tool calls per user question.
MAX_AGENT_ITERATIONS=
# Max completion tokens for router/rewrite/direct-answer calls (reasoning off); default 1024.
LLM_ROUTER_MAX_TOKENS=
# Min reranker score for an internal chunk to count as relevant; below it the router
# escalates to web search. Default 0.2.
INTERNAL_RELEVANCE_THRESHOLD=
# Exa search type: auto (default), fast, or instant.
EXA_SEARCH_TYPE=
# Exa results per web search; default 5.
EXA_NUM_RESULTS=
# Max highlight characters kept per Exa result; default 1500.
EXA_HIGHLIGHT_MAX_CHARACTERS=
# Exa request timeout in seconds; default 20.
EXA_REQUEST_TIMEOUT_SECONDS=
# Bounded retry count for transient Exa failures (429/5xx/network); default 2.
EXA_MAX_RETRIES=
# Private GPU-VM embedding-service base URL.
EMBEDDING_SERVICE_URL=
# Optional authentication token for the embedding service.
EMBEDDING_SERVICE_TOKEN=
# OpenAI-compatible VLM endpoint used by Docling on the GPU VM.
DOCLING_VLM_URL=
# Optional VLM endpoint authentication token.
DOCLING_VLM_TOKEN=
# Hosted VLM model identifier used by Docling.
DOCLING_VLM_MODEL=
# Image render scale for Docling table/picture extraction (higher = sharper).
DOCLING_IMAGE_SCALE=
# Prompt sent to the VLM when captioning images/charts during ingestion.
DOCLING_CAPTION_PROMPT=
# Per-image VLM captioning timeout in seconds.
DOCLING_CAPTION_TIMEOUT_SECONDS=
# Whether ingestion extracts tables to markdown chunks (default true).
DOCLING_EXTRACT_TABLES=
# Whether ingestion extracts charts to tabular data (default true).
DOCLING_EXTRACT_CHARTS=
# Directory where extracted picture images are written during ingestion.
INGESTION_IMAGE_DIR=
# Conversation store backend: memory (default, process-local) or sqlite (persistent).
CONVERSATION_STORE=
# Maximum number of retained conversation turns.
CONVERSATION_HISTORY_MAX_TURNS=
# SQLite file used when CONVERSATION_STORE=sqlite; default data/processed/conversations.db.
CONVERSATION_DB_PATH=
# Hours of inactivity after which a conversation expires; default 24.
CONVERSATION_TTL_HOURS=
# Prior turns shown to the follow-up rewriter and synthesizer; default 3.
CONVERSATION_CONTEXT_TURNS=
# Runtime environment used to select logging output.
APP_ENVIRONMENT=
# Comma-separated browser origins permitted by CORS.
CORS_ORIGINS=
# Qdrant collection containing internal document chunks.
QDRANT_COLLECTION_NAME=
# Named dense vector stored in Qdrant.
QDRANT_DENSE_VECTOR_NAME=
# Named sparse vector stored in Qdrant for Phase 2 hybrid search.
QDRANT_SPARSE_VECTOR_NAME=
# BGE-M3 dense vector dimension (normally 1024).
EMBEDDING_DIMENSION=
# Maximum texts accepted by one embedding request.
EMBEDDING_BATCH_SIZE=
# Embedding-service request timeout in seconds.
EMBEDDING_REQUEST_TIMEOUT_SECONDS=
# GPU inference timeout in seconds.
EMBEDDING_INFERENCE_TIMEOUT_SECONDS=
# Bounded retry count for transient embedding-service failures.
EMBEDDING_MAX_RETRIES=
# Device used by the GPU-local model, e.g. cuda:0 or cpu.
EMBEDDING_DEVICE=
# Whether the GPU-local BGE-M3 model uses FP16.
EMBEDDING_USE_FP16=
# Dense candidates retrieved before answer synthesis.
RETRIEVAL_TOP_K=
# Maximum completion tokens for Sarvam answer synthesis; default 8192. On
# sarvam-105b reasoning tokens are drawn from this budget BEFORE visible content,
# so a low value can return an empty answer (finish_reason="length"). The
# synthesizer auto-retries once at double this budget; raise this if you still
# see "token budget" errors, or set LLM_SYNTH_REASONING_EFFORT=null to disable
# synthesis reasoning entirely.
LLM_SYNTH_MAX_TOKENS=
# Sarvam synthesis request timeout in seconds.
LLM_REQUEST_TIMEOUT_SECONDS=
# Bounded retry count for transient Sarvam failures.
LLM_MAX_RETRIES=
# Directory read by the GPU-hosted ingestion CLI.
INGESTION_DATA_DIR=
# Machine-readable summary written by the ingestion CLI.
INGESTION_SUMMARY_PATH=
# Per-job scratch directory for POST /documents uploads; default data/uploads.
INGESTION_UPLOAD_TEMP_DIR=
# Maximum accepted upload size in bytes for POST /documents; default 52428800 (50 MiB).
MAX_UPLOAD_BYTES=
# Phase 6 evaluation (offline RAGAS + ablation CLI only; not read at request time).
# Path to the curated golden set (JSONL); default data/eval/golden_set.jsonl.
EVAL_GOLDEN_SET_PATH=
# Directory where eval JSON + markdown reports are written; default data/eval/reports.
EVAL_OUTPUT_DIR=
# RAGAS judge model on Sarvam's OpenAI-compatible endpoint; default sarvam-105b.
EVAL_JUDGE_MODEL=
# Sarvam OpenAI-compatible base URL for the judge; default https://api.sarvam.ai/v1.
EVAL_JUDGE_BASE_URL=
# Max concurrent judge calls during an eval run (1-32); default 4.
EVAL_JUDGE_MAX_CONCURRENCY=
# Per judge-call timeout in seconds; default 60.
EVAL_JUDGE_TIMEOUT_SECONDS=
# Max completion tokens per RAGAS judge call; default 4096. Raise if judge
# responses truncate ('output is incomplete due to a max_tokens length limit').
EVAL_JUDGE_MAX_TOKENS=
# Reasoning effort for the judge; blank/null disables it (recommended - reasoning
# consumes the token budget before the structured verdict JSON on sarvam-105b).
EVAL_JUDGE_REASONING_EFFORT=
# Whether the live corpus contains table/image_caption chunks, so the ablation
# runner labels the +graph+multimodal stage honestly; default false.
EVAL_CORPUS_INCLUDES_MULTIMODAL=

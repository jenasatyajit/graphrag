# Copy this file to `.env` and fill in the required credentials below.
# Required keys: SARVAM_API_KEY, OPENROUTER_API_KEY, EXA_API_KEY, QDRANT_URL,
# QDRANT_API_KEY, NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD, and (for the query API)
# EMBEDDING_SERVICE_URL. Every other key is optional: leaving it blank uses the
# built-in default, so only set it when you want a non-default value.

# Sarvam API key for routing and answer synthesis.
SARVAM_API_KEY=
# OpenRouter API key for hosted reranking (cohere/rerank-4-fast).
OPENROUTER_API_KEY=
# Exa API key for live external web search.
EXA_API_KEY=
# Qdrant Cloud endpoint URL.
QDRANT_URL=
# Qdrant Cloud API key.
QDRANT_API_KEY=
# Neo4j AuraDB connection URI.
NEO4J_URI=
# Neo4j database username.
NEO4J_USER=
# Neo4j database password.
NEO4J_PASSWORD=
# Neo4j target database name (AuraDB default is "neo4j").
NEO4J_DATABASE=
# Neo4j query timeout in seconds.
GRAPH_QUERY_TIMEOUT_SECONDS=
# Bounded retry count for transient Neo4j failures.
GRAPH_MAX_RETRIES=
# Maximum hops for graph traversal at query time (1-3).
GRAPH_TRAVERSAL_MAX_HOPS=
# Maximum candidate entity nodes matched per question.
GRAPH_ENTITY_MATCH_LIMIT=
# Maximum graph facts fused into the synthesis context.
GRAPH_FACT_LIMIT=
# Embedding model identifier; e.g. BAAI/bge-m3.
EMBEDDING_MODEL=
# OpenRouter base URL for the /rerank endpoint.
OPENROUTER_BASE_URL=
# OpenRouter reranker model id; default cohere/rerank-4-fast (pro for eval).
RERANK_MODEL=
# Number of candidates returned after reranking.
RERANK_TOP_N=
# Fused candidates sent to the reranker before top-n truncation.
RERANK_CANDIDATE_LIMIT=
# OpenRouter rerank request timeout in seconds.
RERANK_REQUEST_TIMEOUT_SECONDS=
# Bounded retry count for transient OpenRouter rerank failures.
RERANK_MAX_RETRIES=
# Sarvam chat model identifier; e.g. sarvam-105b.
LLM_MODEL=
# Router reasoning effort; leave blank/null to disable it.
LLM_ROUTER_REASONING_EFFORT=
# Synthesis reasoning effort; e.g. low.
LLM_SYNTH_REASONING_EFFORT=
# Graph/entity extraction reasoning effort; default "medium" (low/None give
# empty replies on content-rich chunks). Set null only if you accept a sparse graph.
LLM_EXTRACT_REASONING_EFFORT=
# Max completion tokens for extraction calls; default 4096 (room for reasoning).
LLM_EXTRACT_MAX_TOKENS=
# Maximum total router tool calls per user question.
MAX_AGENT_ITERATIONS=
# Private GPU-VM embedding-service base URL.
EMBEDDING_SERVICE_URL=
# Optional authentication token for the embedding service.
EMBEDDING_SERVICE_TOKEN=
# OpenAI-compatible VLM endpoint used by Docling on the GPU VM.
DOCLING_VLM_URL=
# Optional VLM endpoint authentication token.
DOCLING_VLM_TOKEN=
# Hosted VLM model identifier used by Docling.
DOCLING_VLM_MODEL=
# Conversation store backend selector.
CONVERSATION_STORE=
# Maximum number of retained conversation turns.
CONVERSATION_HISTORY_MAX_TURNS=
# Runtime environment used to select logging output.
APP_ENVIRONMENT=
# Comma-separated browser origins permitted by CORS.
CORS_ORIGINS=
# Qdrant collection containing internal document chunks.
QDRANT_COLLECTION_NAME=
# Named dense vector stored in Qdrant.
QDRANT_DENSE_VECTOR_NAME=
# Named sparse vector stored in Qdrant for Phase 2 hybrid search.
QDRANT_SPARSE_VECTOR_NAME=
# BGE-M3 dense vector dimension (normally 1024).
EMBEDDING_DIMENSION=
# Maximum texts accepted by one embedding request.
EMBEDDING_BATCH_SIZE=
# Embedding-service request timeout in seconds.
EMBEDDING_REQUEST_TIMEOUT_SECONDS=
# GPU inference timeout in seconds.
EMBEDDING_INFERENCE_TIMEOUT_SECONDS=
# Bounded retry count for transient embedding-service failures.
EMBEDDING_MAX_RETRIES=
# Device used by the GPU-local model, e.g. cuda:0 or cpu.
EMBEDDING_DEVICE=
# Whether the GPU-local BGE-M3 model uses FP16.
EMBEDDING_USE_FP16=
# Dense candidates retrieved before answer synthesis.
RETRIEVAL_TOP_K=
# Maximum completion tokens for Sarvam answer synthesis.
LLM_SYNTH_MAX_TOKENS=
# Sarvam synthesis request timeout in seconds.
LLM_REQUEST_TIMEOUT_SECONDS=
# Bounded retry count for transient Sarvam failures.
LLM_MAX_RETRIES=
# Directory read by the GPU-hosted ingestion CLI.
INGESTION_DATA_DIR=
# Machine-readable summary written by the ingestion CLI.
INGESTION_SUMMARY_PATH=
